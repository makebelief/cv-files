#[derive(Debug, PartialEq, Eq)]
pub enum Jacket {
    Black,
    White,
    Flowers,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Hat {
    Snapback,
    Baseball,
    Fedora,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Outfit {
    pub jacket: Jacket,
    pub hat: Hat,
}

pub fn choose_outfit(formality_level: Option<u32>, invitation_message: Result<&str, &str>) -> Outfit {
    // Handle the special case first: formality_level is None AND invitation_message is not Ok()
    if formality_level.is_none() && invitation_message.is_err() {
        return Outfit {
            jacket: Jacket::Flowers,
            hat: Hat::Baseball,
        };
    }
    
    // Determine jacket based on formality_level
    let jacket = match formality_level {
        None => Jacket::Flowers,           // formality_level is unset
        Some(level) if level > 0 => Jacket::White,  // formality_level is more than 0
        Some(_) => Jacket::Black,          // formality_level is 0 or any other value
    };
    
    // Determine hat based on invitation_message
    let hat = match invitation_message {
        Ok(_) => Hat::Fedora,    // invitation_message is Ok()
        Err(_) => Hat::Snapback, // invitation_message is not Ok()
    };
    
    Outfit { jacket, hat }
}

#[cfg(test)]
mod tests {
    use super::*;
    
    #[test]
    fn test_example_case() {
        let result = choose_outfit(Some(0), Ok("Dear friend, ..."));
        assert_eq!(result, Outfit { jacket: Jacket::Black, hat: Hat::Fedora });
    }
    
    #[test]
    fn test_special_case() {
        let result = choose_outfit(None, Err("No invitation"));
        assert_eq!(result, Outfit { jacket: Jacket::Flowers, hat: Hat::Baseball });
    }
    
    #[test]
    fn test_formality_none_invitation_ok() {
        let result = choose_outfit(None, Ok("You're invited"));
        assert_eq!(result, Outfit { jacket: Jacket::Flowers, hat: Hat::Fedora });
    }
    
    #[test]
    fn test_formality_high_invitation_err() {
        let result = choose_outfit(Some(5), Err("No invitation"));
        assert_eq!(result, Outfit { jacket: Jacket::White, hat: Hat::Snapback });
    }
    
    #[test]
    fn test_formality_high_invitation_ok() {
        let result = choose_outfit(Some(3), Ok("Formal invitation"));
        assert_eq!(result, Outfit { jacket: Jacket::White, hat: Hat::Fedora });
    }
}

