partial_sums


pub fn parts_sums(arr: &[u64]) -> Vec<u64> {
    let mut result = Vec::with_capacity(arr.len() + 1);
    
    // Start with the sum of the entire array
    let mut current_sum: u64 = arr.iter().sum();
    result.push(current_sum);
    
    // For each element from right to left, subtract it from current sum
    // This gives us the sum of progressively smaller left partitions
    for &element in arr.iter().rev() {
        current_sum -= element;
        result.push(current_sum);
    }
    
    result
}

// Alternative implementation using the straightforward approach
// (less efficient but more readable)
pub fn parts_sums_straightforward(arr: &[u64]) -> Vec<u64> {
    let mut result = Vec::with_capacity(arr.len() + 1);
    
    // Calculate sum for each partition from full array down to empty
    for i in (0..=arr.len()).rev() {
        let sum: u64 = arr[..i].iter().sum();
        result.push(sum);
    }
    
    result
}

