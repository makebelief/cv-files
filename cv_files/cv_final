pub fn negative_spell(n: i64) -> String {
    if n >= 0 {
        return "error: positive number".to_string();
    }
    
    // Convert to positive for processing
    let num = -n;
    
    format!("minus {}", spell_positive(num))
}

fn spell_positive(n: i64) -> String {
    if n == 0 {
        return "zero".to_string();
    }
    
    let ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
                "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", 
                "seventeen", "eighteen", "nineteen"];
    
    let tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"];
    
    if n < 20 {
        return ones[n as usize].to_string();
    } else if n < 100 {
        let ten = n / 10;
        let one = n % 10;
        if one == 0 {
            return tens[ten as usize].to_string();
        } else {
            return format!("{}-{}", tens[ten as usize], ones[one as usize]);
        }
    } else if n < 1000 {
        let hundred = n / 100;
        let remainder = n % 100;
        let mut result = format!("{} hundred", ones[hundred as usize]);
        if remainder > 0 {
            result.push_str(&format!(" {}", spell_positive(remainder)));
        }
        return result;
    } else if n < 1000000 {
        let thousand = n / 1000;
        let remainder = n % 1000;
        let mut result = format!("{} thousand", spell_positive(thousand));
        if remainder > 0 {
            result.push_str(&format!(" {}", spell_positive(remainder)));
        }
        return result;
    } else if n == 1000000 {
        return "one million".to_string();
    }
    
    // Should not reach here for valid input
    "".to_string()
}

