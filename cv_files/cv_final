pub fn scytale_decoder(s: String, letters_per_turn: u32) -> Option<String> {
    // Return None for empty string or 0 letters per turn
    if s.is_empty() || letters_per_turn == 0 {
        return None;
    }
    
    let chars: Vec<char> = s.chars().collect();
    let len = chars.len();
    let letters_per_turn = letters_per_turn as usize;
    
    // Calculate number of complete rows and handle remainder
    let num_rows = (len + letters_per_turn - 1) / letters_per_turn; // Ceiling division
    
    let mut result = Vec::new();
    
    // Read column by column
    for col in 0..letters_per_turn {
        for row in 0..num_rows {
            let index = row * letters_per_turn + col;
            if index < len {
                result.push(chars[index]);
            }
        }
    }
    
    Some(result.into_iter().collect())
}

