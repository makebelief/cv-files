use std::env;

fn rpn(expression: &str) {
    // Split the expression by whitespace and filter out empty strings
    let tokens: Vec<&str> = expression.split_whitespace().collect();
    
    // Empty expression is invalid
    if tokens.is_empty() {
        println!("Error");
        return;
    }
    
    let mut stack: Vec<i64> = Vec::new();
    
    for token in tokens {
        match token {
            "+" | "-" | "*" | "/" | "%" => {
                // Need at least 2 operands for binary operations
                if stack.len() < 2 {
                    println!("Error");
                    return;
                }
                
                // Pop two operands (note: order matters for - and /)
                let b = stack.pop().unwrap();
                let a = stack.pop().unwrap();
                
                let result = match token {
                    "+" => a + b,
                    "-" => a - b,
                    "*" => a * b,
                    "/" => {
                        if b == 0 {
                            println!("Error");
                            return;
                        }
                        a / b
                    },
                    "%" => {
                        if b == 0 {
                            println!("Error");
                            return;
                        }
                        a % b
                    },
                    _ => unreachable!()
                };
                
                stack.push(result);
            }
            _ => {
                // Try to parse as a number
                match token.parse::<i64>() {
                    Ok(num) => stack.push(num),
                    Err(_) => {
                        println!("Error");
                        return;
                    }
                }
            }
        }
    }
    
    // After evaluation, there should be exactly one value left on the stack
    if stack.len() == 1 {
        println!("{}", stack[0]);
    } else {
        println!("Error");
    }
}

fn main() {
    let args: Vec<String> = env::args().collect();
    
    if args.len() != 2 {
        println!("Error");
        return;
    }
    
    rpn(&args[1]);
}

