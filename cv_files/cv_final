inv_pyramid

fn inv_pyramid(v: String, i: u32) -> Vec<String> {
    let mut result = Vec::new();
    
    // Handle edge case where i is 0
    if i == 0 {
        return result;
    }
    
    // First half: ascending pyramid (1 to i)
    for level in 1..=i {
        let spaces = " ".repeat(level as usize);
        let chars = v.repeat(level as usize);
        result.push(format!("{}{}", spaces, chars));
    }
    
    // Second half: descending pyramid (i-1 down to 1)
    for level in (1..i).rev() {
        let spaces = " ".repeat(level as usize);
        let chars = v.repeat(level as usize);
        result.push(format!("{}{}", spaces, chars));
    }
    
    result
}

