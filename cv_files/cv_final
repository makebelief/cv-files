pub fn reverse_it(v: i32) -> String {
    // Handle the case of 0 separately
    if v == 0 {
        return "00".to_string();
    }
    
    // Determine if the number is negative
    let is_negative = v < 0;
    
    // Work with the absolute value to reverse the digits
    let abs_v = v.abs();
    
    // Convert to string and reverse the digits
    let original_digits = abs_v.to_string();
    let reversed_digits: String = original_digits.chars().rev().collect();
    
    // Build the result string
    if is_negative {
        format!("-{}{}", reversed_digits, abs_v)
    } else {
        format!("{}{}", reversed_digits, v)
    }
}

