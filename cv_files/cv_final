pub fn prev_prime(nbr: u64) -> u64 {
    // Handle edge cases
    if nbr < 2 {
        return 0; // No primes less than 2
    }
    if nbr == 2 {
        return 2; // 2 is the smallest prime
    }
    
    // Start with the given number, but ensure it's odd (except for 2)
    let mut candidate = if nbr % 2 == 0 { nbr - 1 } else { nbr };
    
    // Check each odd number going backwards until we find a prime
    while candidate >= 3 {
        if is_prime(candidate) {
            return candidate;
        }
        candidate -= 2; // Only check odd numbers
    }
    
    // If we've checked all odd numbers >= 3 and none are prime,
    // return 2 (the only even prime)
    2
}

fn is_prime(n: u64) -> bool {
    // Handle small cases
    if n < 2 {
        return false;
    }
    if n == 2 || n == 3 {
        return true;
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false;
    }
    
    // Check for divisors of the form 6k ± 1 up to √n
    // This optimization is based on the fact that all primes > 3
    // can be expressed in the form 6k ± 1
    let sqrt_n = (n as f64).sqrt() as u64;
    let mut i = 5;
    
    while i <= sqrt_n {
        if n % i == 0 || n % (i + 2) == 0 {
            return false;
        }
        i += 6;
    }
    
    true
}

