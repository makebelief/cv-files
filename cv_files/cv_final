nextprime

pub fn next_prime(nbr: u64) -> u64 {
    // Handle edge cases for small numbers
    if nbr <= 2 {
        return 2;
    }
    
    // Start with the given number, but ensure it's odd (except for 2)
    let mut candidate = if nbr % 2 == 0 { nbr + 1 } else { nbr };
    
    // Check each odd number until we find a prime
    loop {
        if is_prime(candidate) {
            return candidate;
        }
        candidate += 2; // Only check odd numbers
    }
}

fn is_prime(n: u64) -> bool {
    // Handle small cases
    if n < 2 {
        return false;
    }
    if n == 2 || n == 3 {
        return true;
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false;
    }
    
    // Check for divisors of the form 6k ± 1 up to √n
    // This optimization is based on the fact that all primes > 3
    // can be expressed in the form 6k ± 1
    let sqrt_n = (n as f64).sqrt() as u64;
    let mut i = 5;
    
    while i <= sqrt_n {
        if n % i == 0 || n % (i + 2) == 0 {
            return false;
        }
        i += 6;
    }
    
    true
}

