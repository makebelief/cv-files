#[derive(Debug, PartialEq, Eq)]
pub enum Jacket {
    Black,
    White,
    Flowers,
}

#[derive(Debug, PartialEq, Eq)]
pub enum Hat {
    Snapback,
    Baseball,
    Fedora,
}

#[derive(Debug, PartialEq, Eq)]
pub struct Outfit {
    pub jacket: Jacket,
    pub hat: Hat,
}

pub fn choose_outfit(formality_level: Option<u32>, invitation_message: Result<&str, &str>) -> Outfit {
    // Handle the special case first: None formality_level and Err invitation_message
    if formality_level.is_none() && invitation_message.is_err() {
        return Outfit {
            jacket: Jacket::Flowers,
            hat: Hat::Baseball,
        };
    }
    
    // Determine jacket based on formality_level
    let jacket = match formality_level {
        None => Jacket::Flowers,           // formality_level is unset
        Some(level) if level > 0 => Jacket::White,  // formality_level is more than 0
        Some(_) => Jacket::Black,          // formality_level is 0 or other values <= 0
    };
    
    // Determine hat based on invitation_message
    let hat = match invitation_message {
        Ok(_) => Hat::Fedora,
        Err(_) => Hat::Snapback,
    };
    
    Outfit { jacket, hat }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_some_zero_ok_message() {
        // Test case from the example
        let outfit = choose_outfit(Some(0), Ok("Dear friend, ..."));
        assert_eq!(outfit, Outfit { jacket: Jacket::Black, hat: Hat::Fedora });
    }

    #[test]
    fn test_none_err_message() {
        // Special case: None formality_level and Err invitation_message
        let outfit = choose_outfit(None, Err("No invitation"));
        assert_eq!(outfit, Outfit { jacket: Jacket::Flowers, hat: Hat::Baseball });
    }

    #[test]
    fn test_none_ok_message() {
        // None formality_level with Ok message (not the special case)
        let outfit = choose_outfit(None, Ok("You're invited"));
        assert_eq!(outfit, Outfit { jacket: Jacket::Flowers, hat: Hat::Fedora });
    }

    #[test]
    fn test_some_positive_ok_message() {
        // Positive formality_level with Ok message
        let outfit = choose_outfit(Some(5), Ok("Formal invitation"));
        assert_eq!(outfit, Outfit { jacket: Jacket::White, hat: Hat::Fedora });
    }

    #[test]
    fn test_some_positive_err_message() {
        // Positive formality_level with Err message
        let outfit = choose_outfit(Some(3), Err("No message"));
        assert_eq!(outfit, Outfit { jacket: Jacket::White, hat: Hat::Snapback });
    }

    #[test]
    fn test_some_zero_err_message() {
        // Zero formality_level with Err message
        let outfit = choose_outfit(Some(0), Err("Error"));
        assert_eq!(outfit, Outfit { jacket: Jacket::Black, hat: Hat::Snapback });
    }
}

