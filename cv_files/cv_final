counting_words

use std::collections::HashMap;

fn counting_words(words: &str) -> HashMap<String, u32> {
    let mut word_count = HashMap::new();
    
    // Split by whitespace and process each token
    for token in words.split_whitespace() {
        // Clean the token by removing punctuation except apostrophes within words
        let cleaned = clean_word(token);
        
        if !cleaned.is_empty() {
            // Convert to lowercase for case-insensitive counting
            let word = cleaned.to_lowercase();
            *word_count.entry(word).or_insert(0) += 1;
        }
    }
    
    word_count
}

fn clean_word(word: &str) -> String {
    let mut result = String::new();
    let chars: Vec<char> = word.chars().collect();
    
    for (i, &ch) in chars.iter().enumerate() {
        if ch.is_alphanumeric() {
            result.push(ch);
        } else if ch == '\'' {
            // Keep apostrophe only if it's between alphanumeric characters
            if i > 0 && i < chars.len() - 1 && 
               chars[i-1].is_alphanumeric() && chars[i+1].is_alphanumeric() {
                result.push(ch);
            }
        }
        // All other punctuation is ignored
    }
    
    result
}

