#[derive(Debug)]
pub struct ChessPosition {
    pub rank: i32,
    pub file: i32,
}

#[derive(Debug)]
pub struct Queen {
    pub position: ChessPosition,
}

impl ChessPosition {
    pub fn new(rank: i32, file: i32) -> Option<Self> {
        // Check if the position is within the valid chessboard bounds (0-7)
        if rank >= 0 && rank <= 7 && file >= 0 && file <= 7 {
            Some(ChessPosition { rank, file })
        } else {
            None
        }
    }
}

impl Queen {
    pub fn new(position: ChessPosition) -> Self {
        Queen { position }
    }

    pub fn can_attack(&self, other: &Queen) -> bool {
        let self_rank = self.position.rank;
        let self_file = self.position.file;
        let other_rank = other.position.rank;
        let other_file = other.position.file;

        // Queens can attack each other if they are on:
        // 1. Same rank (row)
        // 2. Same file (column)
        // 3. Same diagonal (absolute difference of ranks equals absolute difference of files)
        
        self_rank == other_rank ||  // Same rank
        self_file == other_file ||  // Same file
        (self_rank - other_rank).abs() == (self_file - other_file).abs()  // Same diagonal
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_valid_positions() {
        assert!(ChessPosition::new(0, 0).is_some());
        assert!(ChessPosition::new(7, 7).is_some());
        assert!(ChessPosition::new(3, 4).is_some());
    }

    #[test]
    fn test_invalid_positions() {
        assert!(ChessPosition::new(-1, 0).is_none());
        assert!(ChessPosition::new(0, -1).is_none());
        assert!(ChessPosition::new(8, 0).is_none());
        assert!(ChessPosition::new(0, 8).is_none());
    }

    #[test]
    fn test_queens_can_attack_same_rank() {
        let queen1 = Queen::new(ChessPosition::new(2, 3).unwrap());
        let queen2 = Queen::new(ChessPosition::new(2, 6).unwrap());
        assert!(queen1.can_attack(&queen2));
    }

    #[test]
    fn test_queens_can_attack_same_file() {
        let queen1 = Queen::new(ChessPosition::new(2, 3).unwrap());
        let queen2 = Queen::new(ChessPosition::new(5, 3).unwrap());
        assert!(queen1.can_attack(&queen2));
    }

    #[test]
    fn test_queens_can_attack_diagonal() {
        let queen1 = Queen::new(ChessPosition::new(2, 3).unwrap());
        let queen2 = Queen::new(ChessPosition::new(5, 6).unwrap());
        assert!(queen1.can_attack(&queen2));
    }

    #[test]
    fn test_queens_cannot_attack() {
        let queen1 = Queen::new(ChessPosition::new(1, 2).unwrap());
        let queen2 = Queen::new(ChessPosition::new(0, 4).unwrap());
        assert!(!queen1.can_attack(&queen2));
    }
}

